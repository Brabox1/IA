# ═════════════════════════════════════════════
#  NEXUS WHATSAPP AGENT — Pure LLM Mode
# ═════════════════════════════════════════════

# ─── AGENT IDENTITY ───
AGENT_NAME=Nexus
AGENT_OWNER=5598999346792
AGENT_DEFAULT_PERSONALITY=humanized
AGENT_LANGUAGE=pt-BR

# ─── AI PROVIDER ───
# Choose one: openai | claude | gemini
AI_PROVIDER=openai

OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─── BEHAVIOR (pure LLM mode) ───
# Bot behaves like ChatGPT inside WhatsApp.
# Commands and emoji reactions are OFF by default.
COMMANDS_ENABLED=false
COMMANDS_OWNER_ONLY=true
REACTIONS_ENABLED=false

HUMAN_TYPING_ENABLED=true
HUMAN_TYPING_WPM=350
HUMAN_DELAY_MIN=800
HUMAN_DELAY_MAX=2500
READ_RECEIPTS=true
MAX_CONTEXT_MESSAGES=20

# ─── DATABASE ───
DB_TYPE=sqlite
DB_PATH=./database/agent.db

# ─── REDIS (optional, off by default) ───
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── ANTI-SPAM ───
ANTISPAM_ENABLED=true
ANTISPAM_MAX_MSGS_PER_MIN=15
ANTISPAM_COOLDOWN_MS=2000

# ─── GROUP MODE ───
# In groups the bot only replies when mentioned, named, or replied to.
GROUP_RESPOND_ONLY_WHEN_MENTIONED=true
GROUP_MODERATION=false
GROUP_BLOCK_LINKS=false
GROUP_BLOCKED_WORDS=

# ─── API SERVER (optional) ───
API_ENABLED=false
API_PORT=3000
API_TOKEN=change-me-to-a-secret-token
WEBHOOK_URL=

# ─── LOGGING ───
LOG_LEVEL=info
DEBUG_MODE=false
